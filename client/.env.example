# ===========================================
# Teledrive — Environment Variables Template
# ===========================================
# Copy this file to `.env` and adjust as needed.
#   cp .env.example .env
#
# IMPORTANT: Never commit `.env` or `.env.local` to Git.
# They are already listed in `.gitignore`.

# --- API Base URL ---
# Production: Set to the remote backend URL.
#             On Netlify, configure this via the UI instead of this file.
# Development: Leave commented out to use the Vite proxy (see vite.config.js).
# VITE_API_BASE_URL=https://teledrivebackend.pxxlspace.cv

# PORT is set by the deployment platform — leave commented out here
# PORT=3001
JWT_SECRET=your-secret-key-change-this-in-production
UPLOAD_DIR=./uploads

# MySQL Database (required)
# For TiDB Cloud Serverless, copy the "Connection" values from the console:
#   DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
#   DB_PORT=4000
#   DB_USER=<your-username>.root
#   DB_PASSWORD=<your-password>
#   DB_NAME=telegram_drive
#   DB_SSL=true
#   DB_CA_PATH=./tidb-serverless-ca.pem
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=telegram_drive
DB_SSL=true
DB_CA_PATH=
# CORS_ORIGIN=*  # comma-separated origins or * for all (default: *)

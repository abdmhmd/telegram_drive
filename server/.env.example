# PORT=3001
JWT_SECRET=your-secret-key-change-this-in-production
UPLOAD_DIR=./uploads

# MySQL Database (required)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=telegram_drive
